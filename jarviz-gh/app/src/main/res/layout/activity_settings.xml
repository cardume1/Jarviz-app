<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0E0E16">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Configurações do Jarviz" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Escolha o cérebro do Jarviz e personalize como ele conversa com você." android:textColor="#A0A0B5" android:textSize="13sp" android:layout_marginBottom="22dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Provedor de IA" android:textColor="#B0B0C0" android:textSize="13sp"/>
    <Spinner android:id="@+id/spinnerProvedor" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="18dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chave Groq" android:textColor="#B0B0C0" android:textSize="13sp"/>
    <EditText android:id="@+id/campoGroq" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="gsk_..." android:textColorHint="#77778A" android:textColor="#FFFFFF" android:background="@drawable/campo_texto" android:padding="14dp" android:inputType="textPassword" android:layout_marginBottom="14dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chave Gemini" android:textColor="#B0B0C0" android:textSize="13sp"/>
    <EditText android:id="@+id/campoGemini" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="AIza..." android:textColorHint="#77778A" android:textColor="#FFFFFF" android:background="@drawable/campo_texto" android:padding="14dp" android:inputType="textPassword" android:layout_marginBottom="20dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Como posso te chamar?" android:textColor="#B0B0C0" android:textSize="13sp"/>
    <EditText android:id="@+id/campoNome" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Seu nome" android:textColorHint="#77778A" android:textColor="#FFFFFF" android:background="@drawable/campo_texto" android:padding="14dp" android:layout_marginBottom="20dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Personalidade" android:textColor="#B0B0C0" android:textSize="13sp"/>
    <Spinner android:id="@+id/spinnerPersonalidade" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="28dp"/>

    <Button android:id="@+id/btnSalvar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Salvar e voltar" android:textColor="#FFFFFF" android:background="@drawable/botao_redondo_enviar" android:padding="14dp"/>
</LinearLayout>
</ScrollView>
